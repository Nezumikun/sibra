// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum Wind {
  EAST
  SOUTH
  WEST
  NORTH
}

model Player {
  id          Int          @id @default(autoincrement())
  uuid        String       @unique @default(uuid())
  email       String       @unique
  password    String
  name        String
  fullName    String
  role        Role         @default(PLAYER)
  createdAt   DateTime     @default(now())
  gameCreator Game[]
  players     GamePlayer[]
}

model Game {
  id           Int          @id @default(autoincrement())
  uuid         String       @unique @default(uuid())
  createdAt    DateTime     @default(now())
  createdById  Int
  createdBy    Player       @relation(fields: [createdById], references: [id])
  finished     Boolean      @default(false)
  aborted      Boolean      @default(false)
  finishedAt   DateTime?
  roundLimit   Int
  playersCount Int
  players      GamePlayer[]
  rounds       GameRound[]
}

model GamePlayer {
  id           Int          @id @default(autoincrement())
  gameId       Int
  game         Game         @relation(fields: [gameId], references: [id])
  playerId     Int
  player       Player       @relation(fields: [playerId], references: [id])
  initialPlace Wind
  rounds       GameRound[]
  events       RoundEvent[] @relation("createdBy")
  victim       RoundEvent[] @relation("victim")

  @@unique([gameId, initialPlace])
}

model GameRound {
  id          Int          @id @default(autoincrement())
  gameId      Int
  game        Game         @relation(fields: [gameId], references: [id])
  number      Int
  createdById Int
  createdBy   GamePlayer   @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?
  events      RoundEvent[]
}

enum RoundEventType {
  START
  KONG
  MAHJONG
  MAHJONG_AFTER_KONG
  END_OF_WALL
  TENPAI
  NOTEN
  FINISH
  FAKE_MAHJONG
  PENALTY
}

model RoundEvent {
  id             Int            @id @default(autoincrement())
  gameRoundId    Int
  gameRound      GameRound      @relation(fields: [gameRoundId], references: [id])
  createdAt      DateTime       @default(now())
  createdById    Int
  createdBy      GamePlayer     @relation("createdBy", fields: [createdById], references: [id])
  type           RoundEventType
  victimPlayerId Int?
  victimPlayer   GamePlayer?    @relation("victim", fields: [victimPlayerId], references: [id])
}
